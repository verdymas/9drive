MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=

# Google OAuth troubleshooting — "invalid_grant" on refresh means the stored
# refresh token was revoked or expired (typically the OAuth app was in Testing
# mode and its test tokens lapsed, or the saved Client ID differs from the one
# that issued the tokens). 9Drive marks the account "Reconnection Required"
# and stops routing to it. Reconnect from Settings > Connected Storage
# Accounts (or Quota Tracker > Reconnect Google Drive). Verify the OAuth app
# is PUBLISHED (not Testing) in Google Cloud Console and that the Client ID
# here matches the one that issued the tokens.
# Backend and remote-import-worker must use the SAME Google OAuth client.

# WebDAV (read-only) access for rclone / Jellyfin. Blank disables the WebDAV interface.
WEBDAV_PASSWORD=

# Storage Sync (Provider → Virtual): bounded concurrency + scan depth knobs.
SYNC_ACCOUNT_CONCURRENCY=2
SYNC_FOLDER_LIST_CONCURRENCY=2
SYNC_MAX_DEPTH=40
SYNC_DRIVE_MAX_RETRIES=3

# Remote Fetch Worker registry (network relays for Remote Imports).
# Timeout for manual Test Connection health checks (seconds).
WORKER_TEST_TIMEOUT_SECONDS=10
# Allow http://localhost worker endpoints for local relay stubs in dev ONLY.
# Never enable in production — remote relays must use HTTPS.
WORKER_ALLOW_LOCALHOST_HTTP=false
# Managed Cloudflare driver provisioning.
# Cloudflare Workers API base (tests point this at a local fake).
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# Timeout for each Cloudflare Workers API call during provision/deprovision.
CLOUDFLARE_DEPLOY_TIMEOUT_SECONDS=30

# SMB share management (requires Samba installed on the host, outside Docker).
# Set to true to enable the SMB manager endpoints and the Storage > SMB page.
SMB_ENABLED=false
# Optional: override the smb.conf path and restrict share paths to a root.
SMB_CONFIG_PATH=
SMB_ALLOWED_ROOT=

# Telegram Drive storage provider (MTProto user-account login wizard).
# Per-file document size cap for Telegram uploads (free accounts ~2 GiB,
# premium up to 4 GiB; Telegram reports no bucket quota, so no total is shown).
TELEGRAM_MAX_FILE_BYTES=2147483648
# Title of the private channel used as blob storage per connected account.
TELEGRAM_STORAGE_CHANNEL=9drive

# ── Telegram synchronization (channel ↔ 9Drive reconciliation) ──
# Master switch for the periodic auto-sweep. `POST /telegram/sync` is
# always allowed; this only gates the setInterval-driven auto sync.
TELEGRAM_SYNC_AUTO_ENABLED=true
# Sweep cadence in minutes (15–720). 30 keeps load bounded while still
# catching newly-deleted / uploaded files quickly.
TELEGRAM_SYNC_INTERVAL_MINUTES=30
# Page size for `client.iterMessages`. Telegram returns ≤100/page; range 10–200.
TELEGRAM_SYNC_PAGE_SIZE=100
# Maximum pages processed in parallel. Range 1–8.
TELEGRAM_SYNC_CONCURRENCY=2
# Maximum retries per page on FloodWait. FloodWait itself waits the
# requested seconds; this caps how many times we re-enter on a row. Range 0–5.
TELEGRAM_SYNC_FLOOD_WAIT_RETRIES=3
# Cadence for the periodic FULL scan (minutes, 15–10080, default 360 = 6h).
# Pass 2 (deleted-message detection) is full-scan only, so this is what
# makes background detection work. The scheduler promotes an auto-tick to
# `full: true` when the last full scan is older than this. Must be >=
# TELEGRAM_SYNC_INTERVAL_MINUTES; the scheduler clamps to the higher value.
TELEGRAM_SYNC_FULL_EVERY_MINUTES=360
# ⚠️ Opt-in auto-trash: when true, a 9Drive row whose Telegram message has
# been gone for TWO consecutive FULL scans is moved to Trash (soft-delete,
# recoverable via `POST /files/batch/restore`). The sync never hard-deletes
# and never touches the Telegram message itself. Off by default — the spec
# default (telegram-drive.md) is that Telegram deletion never removes a
# 9Drive row.
TELEGRAM_SYNC_TRASH_MISSING=false

# ── Telegram metadata protection (encrypted captions + opaque filenames) ──
# When enabled, Telegram storage captions carry an encrypted `9drive:meta=v1:...`
# payload and physical filenames become opaque `tg_<hex>.bin`. The 9Drive DB
# stays the canonical logical state; the encrypted metadata is a recovery cache.
# ⚠️ If TELEGRAM_METADATA_MASTER_KEY is lost, encrypted Telegram metadata
# cannot be recovered. Never commit the real value.
# Encryption enabled WITHOUT a valid key fails safely: protected uploads are
# refused rather than silently falling back to plaintext.
# See docs/implementation/telegram-metadata-security.md for rollout + migration.
TELEGRAM_METADATA_ENCRYPTION_ENABLED=false
# Cryptographically secure master secret — placeholders only; set a real
# value (>=32 chars, e.g. `openssl rand -base64 48`) before enabling.
TELEGRAM_METADATA_MASTER_KEY=change-this-telegram-metadata-master-key!
# Non-secret HKDF salt/context label. Not a replacement for the master key.
TELEGRAM_CRYPTO_SALT=9drive-telegram-v1
# Obfuscate physical Telegram filenames (tg_<opaque>.bin).
TELEGRAM_OBFUSCATE_FILENAME_ENABLED=false
# Hide the original file extension on the physical Telegram filename.
TELEGRAM_OBFUSCATE_FILE_EXTENSION=true
# Temp dir for chunked (non-Google) resumable upload staging. In Docker this is
# the upload_tmp volume (/data/upload-tmp); local default is ./data/upload-tmp.
UPLOAD_TEMP_DIR=/data/upload-tmp

# Remote Import from URL (queued downloads into your storage accounts).
# Redis + the remote-import-worker service are started by docker-compose
# automatically; these knobs tune the worker behaviour.
REMOTE_IMPORT_ENABLED=true
REMOTE_IMPORT_MAX_BYTES=5368709120
REMOTE_IMPORT_GLOBAL_CONCURRENCY=4
REMOTE_IMPORT_PER_USER_CONCURRENCY=2
REMOTE_IMPORT_MAX_REDIRECTS=5
REMOTE_IMPORT_CONNECT_TIMEOUT_SECONDS=15
REMOTE_IMPORT_IDLE_TIMEOUT_SECONDS=60
REMOTE_IMPORT_JOB_TIMEOUT_HOURS=12
REMOTE_IMPORT_DOWNLOAD_ATTEMPTS=3
REMOTE_IMPORT_UPLOAD_ATTEMPTS=2
REMOTE_IMPORT_TEMP_RETENTION_HOURS=24
REMOTE_IMPORT_PROGRESS_UPDATE_INTERVAL_MS=1000

# HLS/M3U8 remote imports (playlist + segment download, FFmpeg remux in the
# worker container, live recording up to a duration cap).
REMOTE_IMPORT_HLS_ENABLED=true
REMOTE_IMPORT_HLS_MAX_MANIFEST_BYTES=1048576
REMOTE_IMPORT_HLS_MAX_PLAYLIST_DEPTH=4
REMOTE_IMPORT_HLS_MAX_VARIANTS=50
REMOTE_IMPORT_HLS_MAX_SEGMENTS=50000
REMOTE_IMPORT_HLS_MAX_SEGMENT_BYTES=268435456
REMOTE_IMPORT_HLS_SEGMENT_CONCURRENCY=6
REMOTE_IMPORT_HLS_SEGMENT_ATTEMPTS=4
REMOTE_IMPORT_HLS_LIVE_ENABLED=true
REMOTE_IMPORT_HLS_MIN_RECORD_SECONDS=60
REMOTE_IMPORT_HLS_MAX_RECORD_SECONDS=21600
REMOTE_IMPORT_HLS_DEFAULT_CONTAINER=mkv
REMOTE_IMPORT_FFMPEG_PATH=/usr/bin/ffmpeg
REMOTE_IMPORT_FFPROBE_PATH=/usr/bin/ffprobe
REMOTE_IMPORT_FFMPEG_TIMEOUT_SECONDS=3600
REMOTE_IMPORT_HLS_MAX_HEIGHT=2160
REMOTE_IMPORT_HLS_MAX_BANDWIDTH=0
REMOTE_IMPORT_HLS_MAX_KEY_BYTES=65536
# Request context (Referer/Origin/User-Agent/Cookie) for protected sources.
REMOTE_IMPORT_REQUEST_CONTEXT_ENABLED=true
REMOTE_IMPORT_CURL_INPUT_ENABLED=true
REMOTE_IMPORT_REQUEST_CONTEXT_MAX_CURL_BYTES=65536
REMOTE_IMPORT_REQUEST_CONTEXT_MAX_COOKIE_BYTES=16384
REMOTE_IMPORT_REQUEST_CONTEXT_COOKIE_SCOPE=source-host

# ── Telegram Stream (internal byte-range service) ────────────────────────
# Internal DNS URL of the telegram-stream service. Leave empty to disable
# Telegram streaming (the legacy full-GET path is used as a fallback).
TELEGRAM_STREAM_NODE_URL=http://telegram-stream:8081
# HMAC shared secret with telegram-stream. Must match on both sides.
# Generate a random 32+ char string. NEVER commit a real value.
TELEGRAM_STREAM_INTERNAL_SECRET=
# Streaming tunables. Conservative defaults; tune only after benchmark.
TELEGRAM_STREAM_CHUNK_SIZE_BYTES=1048576
TELEGRAM_STREAM_PREFETCH=3
TELEGRAM_STREAM_PARALLELISM=2
TELEGRAM_STREAM_LOG_LEVEL=info
