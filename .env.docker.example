MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_RECAPTCHA_SITE_KEY=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=

# WebDAV (read-only) access for rclone / Jellyfin. Blank disables the WebDAV interface.
WEBDAV_PASSWORD=

# SMB share management (requires Samba installed on the host, outside Docker).
# Set to true to enable the SMB manager endpoints and the Storage > SMB page.
SMB_ENABLED=false
# Optional: override the smb.conf path and restrict share paths to a root.
SMB_CONFIG_PATH=
SMB_ALLOWED_ROOT=

# Remote Import from URL (queued downloads into your storage accounts).
# Redis + the remote-import-worker service are started by docker-compose
# automatically; these knobs tune the worker behaviour.
REMOTE_IMPORT_ENABLED=true
REMOTE_IMPORT_MAX_BYTES=5368709120
REMOTE_IMPORT_GLOBAL_CONCURRENCY=4
REMOTE_IMPORT_PER_USER_CONCURRENCY=2
REMOTE_IMPORT_MAX_REDIRECTS=5
REMOTE_IMPORT_CONNECT_TIMEOUT_SECONDS=15
REMOTE_IMPORT_IDLE_TIMEOUT_SECONDS=60
REMOTE_IMPORT_JOB_TIMEOUT_HOURS=12
REMOTE_IMPORT_DOWNLOAD_ATTEMPTS=3
REMOTE_IMPORT_UPLOAD_ATTEMPTS=2
REMOTE_IMPORT_TEMP_RETENTION_HOURS=24
REMOTE_IMPORT_PROGRESS_UPDATE_INTERVAL_MS=1000
