# 9Drive VPS relay — copy to .env (or set in the hosting panel) and fill in.
# NEVER commit a real .env with secrets.

# Required: shared HMAC secret. Must EXACTLY match the secret pasted in
# 9Drive Workers → Virtual Private Server. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_SECRET=change-me-to-a-long-random-value

# Container listen port. The panel routes HTTPS → this port.
PORT=3000

# Max simultaneous upstream transfers (conservative default for 1 vCPU / 1 GB).
MAX_CONCURRENT_TRANSFERS=2

# Max upstream redirects followed per request (each hop re-validated for SSRF).
MAX_REDIRECTS=5

# Max bytes for the control JSON body (POST /fetch payload). Not file bytes.
MAX_CONTROL_BYTES=65536

# Timeout waiting for upstream response headers (ms). Streaming has no short
# total timeout — long files keep flowing once headers arrive.
UPSTREAM_HEADER_TIMEOUT_MS=20000

# Cap for the legacy non-stream JSON envelope (base64). Streaming mode
# (`response: "stream"`, always used by 9Drive) is uncapped and unbuffered.
MAX_ENVELOPE_BYTES=5242880

# Test-only: allow loopback/private upstream targets for local mocked tests.
# NEVER enable in production. Default off (blocked).
# ALLOW_PRIVATE_UPSTREAM=false

# Optional: asserted public base URL shown by GET /system-health.
# Must be an https URL without credentials, query string, or fragment.
# When unset, /system-health reports publicBaseUrl null with a warning.
# RELAY_PUBLIC_URL=https://relay.example.com

# VPS Browser Warmup (short-lived headless Chromium page prep). Default OFF.
# Lean image (Dockerfile) answers 501 without these; warmup image
# (Dockerfile.warmup, node:20-slim + Chromium) requires both to advertise
# support. Disabled by default until the live gate proves genuine media.
# BROWSER_WARMUP_ENABLED=true
# BROWSER_WARMUP_TIMEOUT_MS=25000
# BROWSER_WARMUP_REPLAY_WINDOW_SECONDS=300
# Warmup image sets this by default; override only for custom Chromium builds.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
