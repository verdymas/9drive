generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid()) @db.Char(36)
  name                   String                  @db.VarChar(191)
  email                  String                  @unique @db.VarChar(191)
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  status                 String                  @default("active") @db.VarChar(32)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  sessions               UserSession[]
  authHandoffs           AuthHandoff[]
  providerConfigs        ProviderConfig[]
  oauthStates            OauthState[]
  connectedAccounts      ConnectedAccount[]
  s3StorageConfigs       S3StorageConfig[]
  telegramStorageConfigs TelegramStorageConfig[]
  telegramAuthStates     TelegramAuthState[]
  files                  File[]
  fileShares             FileShare[]
  filePreviewTokens      FilePreviewToken[]
  folders                Folder[]
  uploadSessions         UploadSession[]
  auditLogs              AuditLog[]
  workspaceInvitesSent   WorkspaceInvite[]       @relation("WorkspaceInvitesSent")
  uploadRoutingPolicy    UploadRoutingPolicy?
  apiKeys                ApiKey[]
  remoteImports          RemoteImport[]
  syncRuns               SyncRun[]
  browserDevicePairings  BrowserDevicePairing[]
  browserDevices         BrowserDevice[]
  capturedResources      CapturedResource[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  name       String    @db.VarChar(191)
  keyPrefix  String    @map("key_prefix") @db.VarChar(32)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  scopes     Json
  status     String    @default("active") @db.VarChar(32)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("api_keys")
}

model UploadRoutingPolicy {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @unique @map("user_id") @db.Char(36)
  mode               String   @default("most_available") @db.VarChar(32)
  priorityAccountIds Json     @map("priority_account_ids")
  roundRobinCursor   Int      @default(0) @map("round_robin_cursor")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upload_routing_policies")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model AuthHandoff {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_handoffs")
}

model ProviderConfig {
  id                    String             @id @default(uuid()) @db.Char(36)
  userId                String?            @map("user_id") @db.Char(36)
  provider              String             @db.VarChar(32)
  clientIdEncrypted     String             @map("client_id_encrypted") @db.Text
  clientSecretEncrypted String             @map("client_secret_encrypted") @db.Text
  redirectUri           String             @map("redirect_uri") @db.Text
  scopes                Json
  status                String             @default("active") @db.VarChar(32)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  oauthStates           OauthState[]
  connectedAccounts     ConnectedAccount[]

  @@index([userId])
  @@index([provider])
  @@map("provider_configs")
}

model OauthState {
  id                 String         @id @default(uuid()) @db.Char(36)
  userId             String?        @map("user_id") @db.Char(36)
  providerConfigId   String         @map("provider_config_id") @db.Char(36)
  flow               String         @default("connect") @db.VarChar(32)
  stateHash          String         @unique @map("state_hash") @db.VarChar(255)
  expiresAt          DateTime       @map("expires_at")
  usedAt             DateTime?      @map("used_at")
  // Bound for the `reconnect` flow: the existing ConnectedAccount this OAuth
  // state must update. Deliberately not an FK — the state outlives the account.
  connectedAccountId String?        @map("connected_account_id") @db.Char(36)
  createdAt          DateTime       @default(now()) @map("created_at")
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig     ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_states")
}

model ConnectedAccount {
  id                    String                  @id @default(uuid()) @db.Char(36)
  userId                String                  @map("user_id") @db.Char(36)
  providerConfigId      String?                 @map("provider_config_id") @db.Char(36)
  provider              String                  @db.VarChar(32)
  providerAccountId     String                  @map("provider_account_id") @db.VarChar(191)
  email                 String                  @db.VarChar(191)
  displayName           String?                 @map("display_name") @db.VarChar(191)
  avatarUrl             String?                 @map("avatar_url") @db.Text
  accessTokenEncrypted  String?                 @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?                 @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?               @map("token_expires_at")
  scopes                Json
  status                String                  @default("connected") @db.VarChar(32)
  // Placement policy, separate from connection state: when false the account
  // is excluded from Automatic new-file routing, but manual selection, Sync,
  // quota refresh and existing reads are unaffected.
  autoAllocationEnabled Boolean                 @default(true) @map("auto_allocation_enabled")
  lastError             String?                 @map("last_error") @db.Text
  // Set when Google refresh fails with invalid_grant: auto-routing is
  // suspended, manual pins fail fast, sync/quota fail fast — until reconnect.
  reauthRequiredAt      DateTime?               @map("reauth_required_at")
  lastAuthErrorCode     String?                 @map("last_auth_error_code") @db.VarChar(64)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig        ProviderConfig?         @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  storageAccount        StorageAccount?
  files                 File[]
  folders               Folder[]
  storageLocations      FolderStorageLocation[]
  uploadSessions        UploadSession[]
  s3StorageConfig       S3StorageConfig?
  telegramStorageConfig TelegramStorageConfig?
  remoteImports         RemoteImport[]
  syncRuns              SyncRun[]
  telegramSyncStates    TelegramSyncState[]
  telegramSyncRuns      TelegramSyncRun[]
  telegramSyncIssues    TelegramSyncIssue[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("connected_accounts")
}

model S3StorageConfig {
  id                       String           @id @default(uuid()) @db.Char(36)
  userId                   String           @map("user_id") @db.Char(36)
  connectedAccountId       String           @unique @map("connected_account_id") @db.Char(36)
  name                     String           @db.VarChar(191)
  bucket                   String           @db.VarChar(191)
  region                   String           @db.VarChar(191)
  endpoint                 String?          @db.Text
  accessKeyIdEncrypted     String           @map("access_key_id_encrypted") @db.Text
  secretAccessKeyEncrypted String           @map("secret_access_key_encrypted") @db.Text
  forcePathStyle           Boolean          @default(false) @map("force_path_style")
  prefix                   String           @default("9drive") @db.VarChar(191)
  quotaBytes               BigInt?          @map("quota_bytes")
  status                   String           @default("active") @db.VarChar(32)
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount         ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("s3_storage_configs")
}

model TelegramStorageConfig {
  id                 String           @id @default(uuid()) @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  connectedAccountId String           @unique @map("connected_account_id") @db.Char(36)
  name               String           @db.VarChar(191)
  apiIdEncrypted     String           @map("api_id_encrypted") @db.Text
  apiHashEncrypted   String           @map("api_hash_encrypted") @db.Text
  sessionEncrypted   String           @map("session_encrypted") @db.Text
  channelId          String?          @map("channel_id") @db.VarChar(191)
  channelTitle       String?          @map("channel_title") @db.VarChar(191)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_storage_configs")
}

model TelegramAuthState {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @map("user_id") @db.Char(36)
  connectedAccountId String?  @map("connected_account_id") @db.Char(36)
  step               String   @default("awaiting_code") @db.VarChar(32)
  apiIdEncrypted     String   @map("api_id_encrypted") @db.Text
  apiHashEncrypted   String   @map("api_hash_encrypted") @db.Text
  phoneEncrypted     String?  @map("phone_encrypted") @db.Text
  codeHashEncrypted  String?  @map("code_hash_encrypted") @db.Text
  sessionEncrypted   String   @map("session_encrypted") @db.Text
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_auth_states")
}

model StorageAccount {
  id                 String           @id @default(uuid()) @db.Char(36)
  connectedAccountId String           @unique @map("connected_account_id") @db.Char(36)
  totalBytes         BigInt?          @map("total_bytes")
  usedBytes          BigInt           @default(0) @map("used_bytes")
  availableBytes     BigInt?          @map("available_bytes")
  trashBytes         BigInt?          @map("trash_bytes")
  fileCount          Int              @default(0) @map("file_count")
  lastSyncedAt       DateTime?        @map("last_synced_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("storage_accounts")
}

model File {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @map("user_id") @db.Char(36)
  connectedAccountId String             @map("connected_account_id") @db.Char(36)
  folderId           String?            @map("folder_id") @db.Char(36)
  provider           String             @db.VarChar(32)
  providerFileId     String             @map("provider_file_id") @db.VarChar(191)
  name               String             @db.VarChar(255)
  mimeType           String             @map("mime_type") @db.VarChar(191)
  sizeBytes          BigInt             @map("size_bytes")
  checksum           String?            @db.VarChar(191)
  status             String             @default("active") @db.VarChar(32)
  // Generation marker for account-scoped missing reconciliation: the SyncRun
  // that last saw this provider file during a successful complete scan. NULL
  // = never stamped (legacy row) — never treated as missing. Deliberately NOT
  // a foreign key: compared, never joined.
  lastSeenSyncRunId  String?            @map("last_seen_sync_run_id") @db.VarChar(36)
  // 9Drive stable logical identity (mirrors the `9drive:id=` caption field on
  // Telegram storage documents). Survives re-uploads, channel moves, and
  // filename changes — independent of `providerFileId`. Null for legacy rows
  // and for non-Telegram providers; the Telegram ingest stamps it on the
  // first caption it sees. The DB is the source of truth for the logical
  // filesystem; this column is the stable key that 9Drive metadata uses.
  telegramStableId  String?            @map("telegram_stable_id") @db.VarChar(36)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount   @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  folder             Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares             FileShare[]
  previewTokens      FilePreviewToken[]
  remoteImport       RemoteImport?      @relation("RemoteImportFile")

  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([userId, status, folderId, createdAt])
  @@index([connectedAccountId])
  @@index([folderId])
  @@index([providerFileId])
  @@index([connectedAccountId, status, lastSeenSyncRunId])
  // 9Drive logical-identity lookup: ingest by `9drive:id=<stableId>` resolves
  // to one row per user; the composite covers that without leaking the
  // nullable column into a global unique index.
  @@index([userId, telegramStableId])
  @@map("files")
}

model RemoteImport {
  id                          String             @id @default(uuid()) @db.Char(36)
  userId                      String             @map("user_id") @db.Char(36)
  folderId                    String?            @map("folder_id") @db.Char(36)
  connectedAccountId          String?            @map("connected_account_id") @db.Char(36)
  // Selected Remote Fetch Worker (null = Direct / no relay). Persisted before
  // enqueueing so retries use the same worker. `workerNameSnapshot` preserves
  // the choice in history even if the worker is later renamed or deleted.
  workerId                    String?            @map("worker_id") @db.Char(36)
  workerNameSnapshot          String?            @map("worker_name_snapshot") @db.VarChar(191)
  fileId                      String?            @unique @map("file_id") @db.Char(36)
  sourceUrlEncrypted          String             @map("source_url_encrypted") @db.Text
  // User-supplied Referer/Origin/User-Agent/Cookie for protected sources,
  // AES-256-GCM encrypted at rest; never returned by any API (booleans only).
  requestContextEncrypted     String?            @map("request_context_encrypted") @db.Text
  displayUrl                  String             @map("display_url") @db.Text
  finalUrlEncrypted           String?            @map("final_url_encrypted") @db.Text
  fileName                    String             @map("file_name") @db.VarChar(255)
  // Original source filename from the captured resource (e.g. "master.m3u8")
  // preserved separately from the upload-derived fileName which carries the
  // output container extension (e.g. "master.mkv"). Null for non-capture/legacy.
  sourceFileName              String?            @map("source_file_name") @db.VarChar(255)
  mimeType                    String?            @map("mime_type") @db.VarChar(191)
  status                      String             @default("queued") @db.VarChar(32)
  stage                       String             @default("waiting") @db.VarChar(32)
  totalBytes                  BigInt?            @map("total_bytes")
  downloadedBytes             BigInt             @default(0) @map("downloaded_bytes")
  uploadedBytes               BigInt             @default(0) @map("uploaded_bytes")
  // Final output size (the file being uploaded) — distinct from `totalBytes`,
  // which is the SOURCE download size. For HLS the two often differ.
  uploadTotalBytes            BigInt?            @map("upload_total_bytes")
  sourceETag                  String?            @map("source_etag") @db.VarChar(191)
  sourceLastModified          DateTime?          @map("source_last_modified")
  sourceRangeSupported        Boolean            @default(false) @map("source_range_supported")
  // ── HLS/M3U8 source metadata (populated by the probe for HLS imports) ─────
  sourceType                  String?            @map("source_type") @db.VarChar(32)
  hlsPlaylistType             String?            @map("hls_playlist_type") @db.VarChar(16)
  hlsVariantId                String?            @map("hls_variant_id") @db.VarChar(64)
  hlsVariantBandwidth         Int?               @map("hls_variant_bandwidth")
  hlsVariantWidth             Int?               @map("hls_variant_width")
  hlsVariantHeight            Int?               @map("hls_variant_height")
  hlsAudioTrackId             String?            @map("hls_audio_track_id") @db.VarChar(64)
  hlsAudioTrackLanguage       String?            @map("hls_audio_track_language") @db.VarChar(32)
  hlsOutputContainer          String?            @map("hls_output_container") @db.VarChar(16)
  hlsIsLive                   Boolean?           @map("hls_is_live")
  hlsRecordingDurationSeconds Int?               @map("hls_recording_duration_seconds")
  hlsMediaDurationSeconds     Float?             @map("hls_media_duration_seconds")
  hlsSegmentCount             Int?               @map("hls_segment_count")
  hlsCompletedSegmentCount    Int?               @map("hls_completed_segment_count")
  remuxProgress               Float?             @map("remux_progress")
  outputDurationSeconds       Float?             @map("output_duration_seconds")
  outputCodecSummary          String?            @map("output_codec_summary") @db.VarChar(191)
  tempPath                    String?            @map("temp_path") @db.Text
  resumeSessionEncrypted      String?            @map("resume_session_encrypted") @db.Text
  jobId                       String?            @map("job_id") @db.VarChar(191)
  attempt                     Int                @default(0)
  // Queue-lifecycle metadata (spec: retry/queue fix). `queuedAt` is set only
  // when queue.add() actually succeeded; `heartbeatAt` is the rolling liveness
  // signal while the worker is active; `retryFromStage` is the server-derived
  // resume stage for a retry (never frontend-supplied).
  queuedAt                    DateTime?          @map("queued_at")
  retryRequestedAt            DateTime?          @map("retry_requested_at")
  heartbeatAt                 DateTime?          @map("heartbeat_at")
  retryFromStage              String?            @map("retry_from_stage") @db.VarChar(32)
  errorCode                   String?            @map("error_code") @db.VarChar(64)
  errorMessage                String?            @map("error_message") @db.Text
  internalError               String?            @map("internal_error") @db.Text
  startedAt                   DateTime?          @map("started_at")
  completedAt                 DateTime?          @map("completed_at")
  failedAt                    DateTime?          @map("failed_at")
  cancelledAt                 DateTime?          @map("cancelled_at")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder                      Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  connectedAccount            ConnectedAccount?  @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  worker                      RemoteFetchWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  file                        File?              @relation("RemoteImportFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([jobId])
  @@index([folderId])
  @@index([status, queuedAt])
  @@index([workerId])
  @@map("remote_imports")
}

model FileShare {
  id        String    @id @default(uuid()) @db.Char(36)
  fileId    String    @map("file_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  token     String?   @unique @db.VarChar(191)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  enabled   Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@index([userId, enabled, createdAt])
  @@index([fileId, userId, enabled, createdAt])
  @@map("file_shares")
}

model FilePreviewToken {
  id        String   @id @default(uuid()) @db.Char(36)
  fileId    String   @map("file_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@map("file_preview_tokens")
}

model Folder {
  id                 String                  @id @default(uuid()) @db.Char(36)
  userId             String                  @map("user_id") @db.Char(36)
  parentId           String?                 @map("parent_id") @db.Char(36)
  connectedAccountId String?                 @map("connected_account_id") @db.Char(36)
  provider           String                  @default("google_drive") @db.VarChar(32)
  providerFolderId   String?                 @map("provider_folder_id") @db.VarChar(191)
  name               String                  @db.VarChar(255)
  // Normalized name used by Sync folder matching (NFC + trim + lowercase).
  // NULL for user-created rows — MySQL unique indexes allow multiple NULLs, so
  // user-created duplicates stay unconstrained while sync-created names are
  // always normalized and enforced.
  normalizedName     String?                 @map("normalized_name") @db.VarChar(255)
  // 'user' = user-created virtual folder (never auto-pruned/auto-renamed by
  // Sync); 'sync' = discovered on a provider, eligible for the safe
  // single-location in-place rename optimization.
  origin             String                  @default("user") @db.VarChar(16)
  color              String                  @default("text-blue-500") @db.VarChar(64)
  iconUrl            String?                 @map("icon_url") @db.Text
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  deletedAt          DateTime?               @map("deleted_at")
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             Folder?                 @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Folder[]                @relation("FolderChildren")
  connectedAccount   ConnectedAccount?       @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  storageLocations   FolderStorageLocation[]
  files              File[]
  uploadSessions     UploadSession[]         @relation("UploadSessionFolder")
  remoteImports      RemoteImport[]

  @@unique([userId, parentId, normalizedName], map: "folders_user_parent_normalized_name_unique")
  @@index([userId])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, deletedAt, parentId, updatedAt])
  @@index([parentId])
  @@index([connectedAccountId])
  @@map("folders")
}

model FolderStorageLocation {
  id                 String           @id @default(uuid()) @db.Char(36)
  folderId           String           @map("folder_id") @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  provider           String           @db.VarChar(32)
  providerFolderId   String           @map("provider_folder_id") @db.VarChar(191)
  // Generation marker for account-scoped missing reconciliation — see File.
  // Plain indexed column, deliberately NOT a foreign key.
  lastSeenSyncRunId  String?          @map("last_seen_sync_run_id") @db.VarChar(36)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  folder             Folder           @relation(fields: [folderId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([folderId, connectedAccountId])
  @@index([connectedAccountId])
  @@index([folderId])
  @@index([connectedAccountId, lastSeenSyncRunId])
  @@map("folder_storage_locations")
}

model SyncRun {
  id                 String           @id @default(uuid()) @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  provider           String           @db.VarChar(32)
  status             String           @default("running") @db.VarChar(16) // running|completed|failed|cancelled
  startedAt          DateTime         @default(now()) @map("started_at")
  completedAt        DateTime?        @map("completed_at")
  errorCode          String?          @map("error_code") @db.VarChar(64)
  errorMessage       String?          @map("error_message") @db.Text
  // Run statistics as scalar columns (mirrors the RemoteImport scalar style).
  foldersDiscovered  Int              @default(0) @map("folders_discovered")
  filesDiscovered    Int              @default(0) @map("files_discovered")
  foldersCreated     Int              @default(0) @map("folders_created")
  mappingsCreated    Int              @default(0) @map("mappings_created")
  mappingsReused     Int              @default(0) @map("mappings_reused")
  mappingsDetached   Int              @default(0) @map("mappings_detached")
  filesCreated       Int              @default(0) @map("files_created")
  filesUpdated       Int              @default(0) @map("files_updated")
  filesMoved         Int              @default(0) @map("files_moved")
  filesMissing       Int              @default(0) @map("files_missing")
  mappingsMissing    Int              @default(0) @map("mappings_missing")
  collisionsDetected Int              @default(0) @map("collisions_detected")
  // ── Telegram reconciliation stats (additive; non-breaking for legacy rows) ─
  scannedCount       Int              @default(0) @map("scanned_count")
  matchedCount       Int              @default(0) @map("matched_count")
  importedCount      Int              @default(0) @map("imported_count")
  missingCount       Int              @default(0) @map("missing_count")
  orphanCount        Int              @default(0) @map("orphan_count")
  conflictCount      Int              @default(0) @map("conflict_count")
  errorCount         Int              @default(0) @map("error_count")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([connectedAccountId, createdAt])
  @@map("sync_runs")
}

model UploadSession {
