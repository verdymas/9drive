// ── Browser Capture: a registered browser extension instance ("device") and
// the resources it detects. The extension is a CAPTURE CLIENT only — it never
// downloads bytes; every import goes through the existing Remote Import
// pipeline. Device tokens are stored hashed (same pattern as refresh/API-key
// tokens); captured URLs are untrusted input validated at submit AND again at
// import time by the Remote Import URL gate.
model BrowserDevicePairing {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  codeHash  String    @unique @map("code_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("browser_device_pairings")
}

model BrowserDevice {
  id                String             @id @default(uuid()) @db.Char(36)
  userId            String             @map("user_id") @db.Char(36)
  name              String             @db.VarChar(191)
  browser           String             @db.VarChar(64)
  platform          String             @db.VarChar(64)
  extensionVersion  String?            @map("extension_version") @db.VarChar(32)
  // Hashed device credential — raw token is shown once at registration/rotation.
  deviceTokenHash   String             @unique @map("device_token_hash") @db.VarChar(255)
  status            String             @default("active") @db.VarChar(32)
  lastSeenAt        DateTime?          @map("last_seen_at")
  revokedAt         DateTime?          @map("revoked_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  capturedResources CapturedResource[]

  @@index([userId])
  @@index([userId, status])
  @@map("browser_devices")
}

model CapturedResource {
  id                      String        @id @default(uuid()) @db.Char(36)
  browserDeviceId         String        @map("browser_device_id") @db.Char(36)
  userId                  String        @map("user_id") @db.Char(36)
  // Full URL (signed query params intact — needed for the actual download),
  // AES-256-GCM encrypted at rest. `displayUrl` strips query/hash for UI.
  urlEncrypted            String        @map("url_encrypted") @db.Text
  displayUrl              String        @map("display_url") @db.Text
  // video | hls | dash | document
  type                    String        @db.VarChar(16)
  mimeType                String?       @map("mime_type") @db.VarChar(191)
  filename                String        @db.VarChar(255)
  pageUrl                 String?       @map("page_url") @db.Text
  pageTitle               String?       @map("page_title") @db.VarChar(512)
  // Safe context only (referer/origin/userAgent) — cookies are NEVER accepted;
  // values validated + encrypted at rest, booleans-only across the API.
  requestContextEncrypted String?       @map("request_context_encrypted") @db.Text
  // ── Phase 14: Media Identity (extension-side scoring, top-level fields only).
  // The full candidates list stays in the extension; the backend only persists
  // the winner so the Remote Imports UI can show "from JSON-LD" / etc. All
  // three fields default to safe empty values so legacy rows + the wire
  // continue to validate.
  mediaIdentityTitle      String?       @map("media_identity_title") @db.VarChar(512)
  mediaIdentitySource     String?       @map("media_identity_source") @db.VarChar(64)
  mediaIdentityConfidence Int           @default(0) @map("media_identity_confidence")
  // pending | consumed | expired | deleted
  status                  String        @default("pending") @db.VarChar(16)
  detectedAt              DateTime      @default(now()) @map("detected_at")
  expiresAt               DateTime      @map("expires_at")
  importedAt              DateTime?     @map("imported_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  device                  BrowserDevice @relation(fields: [browserDeviceId], references: [id], onDelete: Cascade)
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, detectedAt])
  @@index([browserDeviceId, status])
  @@index([status, expiresAt])
  @@map("captured_resources")
}

// ── Remote Fetch Worker: a remote network relay used by 9Drive to fetch
// remote resources for Remote Imports. Workers are relays/transports ONLY —
// FFmpeg, HLS parsing, orchestration, temp files and uploads stay in 9Drive.
// Provider-agnostic by design: `driver` is a string resolved against the
// backend driver registry (cloudflare first; future: generic-http-relay,
// vercel, self-hosted), never Cloudflare-specific columns.
model RemoteFetchWorker {
  id                String         @id @default(uuid()) @db.Char(36)
  name              String         @db.VarChar(191)
  slug              String?        @unique @db.VarChar(191)
  driver            String         @db.VarChar(64)
  // System-managed for managed (provisioned) drivers — null until deployment
  // succeeds. User-supplied for manual drivers (future self-hosted relays).
  endpointUrl       String?        @map("endpoint_url") @db.Text
  isEnabled         Boolean        @default(true) @map("is_enabled")
  isDefault         Boolean        @default(false) @map("is_default")
  priority          Int?
  region            String?        @db.VarChar(64)
  description       String?        @db.Text
  // hmac | bearer | none — validated in application code against the driver.
  authType          String         @default("hmac") @map("auth_type") @db.VarChar(16)
  // Sensitive provider credentials (shared secret, bearer token), AES-256-GCM
  // encrypted at rest; never returned by any API (`credentialConfigured` only).
  secretEncrypted   String?        @map("secret_encrypted") @db.Text
  configEncrypted   String?        @map("config_encrypted") @db.Text
  // Last-known safe capability set from a successful test connection.
  capabilitiesJson  Json?          @map("capabilities_json")
  // Safe non-sensitive display metadata only.
  metadataJson      Json?          @map("metadata_json")
  // unknown | healthy | unhealthy | disabled | provisioning | provision_failed
  status            String         @default("unknown") @db.VarChar(16)
  lastHealthCheckAt DateTime?      @map("last_health_check_at")
  lastHealthyAt     DateTime?      @map("last_healthy_at")
  lastFailedAt      DateTime?      @map("last_failed_at")
  lastErrorCode     String?        @map("last_error_code") @db.VarChar(64)
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  remoteImports     RemoteImport[]

  @@index([driver])
  @@index([isEnabled])
  @@index([isDefault])
  @@index([status])
  @@index([deletedAt])
  @@map("remote_fetch_workers")
}

// ── Telegram Synchronization ─────────────────────────────────────────────
// Reconciliation ledger for Telegram ↔ 9Drive. The DB (9Drive) is the
// authoritative logical filesystem; the channel is a mirror. The sync
// service never deletes data — issues are flagged here and reviewed
// via the HTTP surface.
//
// `TelegramSyncState` is one row per ConnectedAccount. It carries the
// pagination cursor (`lastMessageId`) and the derived status vocabulary
// (`never_synced | syncing | up_to_date | changes_detected |
// needs_attention | sync_failed`). The `status = 'syncing'` value is
// also the single-flight guard (atomic UPDATE refuses to overwrite).
//
// `TelegramSyncRun` is one row per sync invocation. Stats are scalar
// columns so the UI can merge runs without JSON parsing.
//
// `TelegramSyncIssue` is the non-destructive reconciliation log:
//   - `ORPHAN_REMOTE_FILE` — Telegram message has no DB row
//   - `REMOTE_FILE_MISSING` — DB row has no Telegram message
//   - `TELEGRAM_METADATA_MISMATCH` — DB row's logical metadata
//     (filename/folder/size/mime) differs from the channel
//
// All three tables are append-only by convention — issues are
// resolved by setting `resolvedAt`, never by DELETE. The sync NEVER
// re-uploads a missing file automatically; manual reconciliation
// only (spec §13).
model TelegramSyncState {
  id                 String           @id @default(uuid()) @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  connectedAccountId String           @unique(map: "telegram_sync_state_account_id_key") @map("connected_account_id") @db.Char(36)
  // Pagination cursor: highest message id seen in the last successful
  // scan. Incremental sync resumes at `min_id = lastMessageId`.
  lastMessageId      BigInt?          @map("last_message_id")
  lastScanAt         DateTime?        @map("last_scan_at")
  // never_synced | syncing | up_to_date | changes_detected |
  // needs_attention | sync_failed
  status             String           @default("never_synced") @map("status") @db.VarChar(32)
  // Last-error code/message from a failed run (NEVER a session
  // string, API hash, OTP, password, or authorization secret).
  errorCode          String?          @map("error_code") @db.VarChar(64)
  errorMessage       String?          @map("error_message") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId], name: "telegram_sync_state_user_idx")
  @@map("telegram_sync_state")
}

model TelegramSyncRun {
  id                 String           @id @default(uuid()) @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  // running | completed | failed | cancelled
  status             String           @default("running") @map("status") @db.VarChar(16)
  startedAt          DateTime         @default(now()) @map("started_at")
  finishedAt         DateTime?        @map("finished_at")
  // Reconciliation stats (spec §16). All default 0 — non-breaking for
  // legacy rows.
  scannedCount       Int              @default(0) @map("scanned_count")
  matchedCount       Int              @default(0) @map("matched_count")
  importedCount      Int              @default(0) @map("imported_count")
  missingCount       Int              @default(0) @map("missing_count")
  orphanCount        Int              @default(0) @map("orphan_count")
  conflictCount      Int              @default(0) @map("conflict_count")
  errorCount         Int              @default(0) @map("error_count")
  errorCode          String?          @map("error_code") @db.VarChar(64)
  errorMessage       String?          @map("error_message") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], name: "telegram_sync_runs_user_created_idx")
  @@index([connectedAccountId, createdAt], name: "telegram_sync_runs_acct_created_idx")
  @@map("telegram_sync_runs")
}

model TelegramSyncIssue {
  id                 String           @id @default(uuid()) @db.Char(36)
  userId             String           @map("user_id") @db.Char(36)
  runId              String?          @map("run_id") @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  // ORPHAN_REMOTE_FILE | REMOTE_FILE_MISSING | TELEGRAM_METADATA_MISMATCH
  kind               String           @map("kind") @db.VarChar(32)
  // Telegram-side physical reference (`telegram://channel/messageId`)
  // when the issue is about a Telegram document. Nullable for issues
  // that resolve purely on the 9Drive side.
  telegramFileId     String?          @map("telegram_file_id") @db.VarChar(191)
  // 9Drive-side file id when the issue resolves to a known row.
  fileId             String?          @map("file_id") @db.Char(36)
  detectedAt         DateTime         @default(now()) @map("detected_at")
  resolvedAt         DateTime?        @map("resolved_at")
  // Arbitrary JSON metadata: original DB row fields, Telegram fields,
  // or whatever the resolver needs to make a decision. Never stores
  // secrets.
  metadata           Json?
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([userId, connectedAccountId, resolvedAt], name: "telegram_sync_issues_user_acct_resolved_idx")
  @@index([runId], name: "telegram_sync_issues_run_idx")
  @@index([telegramFileId], name: "telegram_sync_issues_tg_file_idx")
  @@index([fileId], name: "telegram_sync_issues_file_idx")
  @@map("telegram_sync_issues")
}
